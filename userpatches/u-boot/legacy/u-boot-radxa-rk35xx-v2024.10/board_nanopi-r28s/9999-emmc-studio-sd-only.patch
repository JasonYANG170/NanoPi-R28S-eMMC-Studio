--- a/include/configs/rockchip-common.h
+++ b/include/configs/rockchip-common.h
@@ -209,6 +209,18 @@
 	"bootrkp;"
 #endif
 
+#ifdef CONFIG_EMMC_STUDIO_SD_ONLY
+#undef BOOT_TARGET_DEVICES
